{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "shaper-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "shaper-attach",
      "url": "http://localhost:3000",
      "port": 3000
    },
    {
      "name": "shaper-dev-3005",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--",
        "-p",
        "3005"
      ],
      "port": 3005
    },
    {
      "name": "practice-rack-wifi",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "SHAPER_RACK_STAND_IN=1",
        "npm",
        "run",
        "dev",
        "--",
        "-H",
        "0.0.0.0",
        "-p",
        "3005"
      ],
      "port": 3005
    },
    {
      "name": "review-stand-ins",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "SHAPER_CONTACT_STAND_IN=1",
        "SHAPER_RACK_STAND_IN=1",
        "npm",
        "run",
        "dev",
        "--",
        "-H",
        "0.0.0.0",
        "-p",
        "3005"
      ],
      "port": 3005
    }
  ]
}
