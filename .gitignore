# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env
.env.*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# GSD runtime scratch (dispatch-isolation sentinel, etc.)
.gsd/
.env*

# Google Cloud OAuth client secret downloads (Google's default download filename) — never
# belongs in a repo; see Phase 2 threat T-02-08. If you find one of these in the repo root,
# move it out of the working tree entirely rather than relying on this ignore rule.
client_secret_*.json
